<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="ToolbarBaseStyle">
        <item name="android:background">?attr/colorPrimary</item>
        <item name="android:backgroundTint">?attr/colorPrimary</item>
    </style>

    <style name="ToolbarStyle" parent="ToolbarBaseStyle">
        <item name="navigationIcon">?attr/homeAsUpIndicator</item>
        <item name="navigationIconTint">@color/back_button</item>
    </style>

    <style name="ToolbarTitleTextAppearanceStyle" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:fontFamily">@font/ys_display_medium</item>
    </style>

    <style name="SettingsIconStyle">
        <item name="android:backgroundTint">?attr/colorPrimary</item>
    </style>

    <style name="SettingsTextViewStyle">
        <item name="android:textColor">?attr/colorOnBackground</item>
        <item name="android:textSize">@dimen/settings_font_size</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
    </style>

    <style name="TrackTextStyle">
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:lines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="TrackTitleStyle" parent="TrackTextStyle">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/track_title_size</item>
    </style>

    <style name="TrackSubtitleStyle" parent="TrackTextStyle">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/track_subtitle_size</item>
    </style>

    <style name="MessageStyle">
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/search_msg</item>
        <item name="android:textSize">19sp</item>
    </style>

    <style name="PrimaryButtonStyle">
        <item name="android:backgroundTint">@color/button_background</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:maxLines">1</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/reload_button_text</item>
        <item name="android:textSize">14sp</item>
        <item name="cornerRadius">54dp</item>
    </style>

    <style name="SearchEditTextStyle" parent="ThemeOverlay.MaterialComponents">
        <item name="colorPrimary">@color/blue</item>
        <item name="colorControlActivated">@color/blue</item>
    </style>

    <style name="PlayerControlButtonStyle">
        <item name="android:layout_width">51dp</item>
        <item name="android:layout_height">51dp</item>
        <item name="android:background">@drawable/round_button</item>
        <item name="android:tint">@color/white</item>
    </style>

    <style name="PlayerTextStyle">
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="PlayerTrackNameStyle" parent="PlayerTextStyle">
        <item name="android:textSize">22sp</item>
    </style>

    <style name="PlayerArtistNameStyle" parent="PlayerTextStyle">
        <item name="android:textSize">14sp</item>
    </style>

    <style name="PlayerTimerStyle" parent="PlayerTextStyle">
        <item name="android:textSize">14sp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="PlayerInfoStyle">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:paddingTop">9dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="PlayerInfoLabelStyle" parent="PlayerInfoStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="PlayerInfoValueStyle" parent="PlayerInfoStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:gravity">end</item>
        <item name="android:ellipsize">end</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="TabLayoutStyle" parent="Widget.MaterialComponents.TabLayout">
        <item name="android:background">?attr/colorPrimary</item>
        <item name="tabIndicatorColor">@color/back_button</item>
        <item name="tabIndicatorHeight">2dp</item>
        <item name="tabTextColor">@color/back_button</item>
        <item name="tabIndicatorFullWidth">false</item>
        <item name="tabMode">fixed</item>
        <item name="tabGravity">fill</item>
        <item name="tabTextAppearance">@style/TabTextAppearanceStyle</item>
    </style>

    <style name="TabTextAppearanceStyle" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="BottomNavTextAppearanceStyle" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="PlaylistTextInputStyle" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">4dp</item>
        <item name="boxCornerRadiusTopEnd">4dp</item>
        <item name="boxCornerRadiusBottomStart">4dp</item>
        <item name="boxCornerRadiusBottomEnd">4dp</item>
        <item name="boxStrokeColor">@color/text_secondary</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1dp</item>
        <item name="hintTextColor">@color/text_secondary</item>
        <item name="hintTextAppearance">@style/PlaylistTextInputHintStyle</item>
        <item name="android:textColorHint">@color/text_field_playlist</item>
    </style>

    <style name="PlaylistTextInputHintStyle" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="CreatePlaylistButtonStyle" parent="PrimaryButtonStyle">
        <item name="android:backgroundTint">@color/create_button_background</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="PlaylistAlertDialogTheme" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="buttonBarPositiveButtonStyle">@style/PlaylistAlertDialogButtonStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/PlaylistAlertDialogButtonStyle</item>
        <item name="materialAlertDialogTitleTextStyle">@style/PlaylistAlertDialogTitleStyle</item>
    </style>

    <style name="PlaylistAlertDialogButtonStyle" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textColor">@color/blue</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="PlaylistAlertDialogTitleStyle" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textColor">@color/text_field_playlist</item>
    </style>

</resources>
